{
  "name": "realtime-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marketplace WebSocket and Socket.IO event relay service",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development npm run build && npm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/server.mjs",
    "lint": "node ./scripts/lint.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"contracts/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"*.{mjs,json,yml,md}\" \".github/**/*.yml\" \"docs/**/*.md\"",
    "format": "prettier --write \"src/**/*.ts\" \"contracts/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"*.{mjs,json,yml,md}\" \".github/**/*.yml\" \"docs/**/*.md\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./tests/run-tests.mjs",
    "security": "npm audit --audit-level=high",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "test:integration": "npm run build && node --test ./tests/socketio/*.integration.test.mjs",
    "test:e2e": "node --test ./tests/e2e/*.test.mjs",
    "docker:validate": "node ./scripts/docker-validation.mjs",
    "smoke": "node ./scripts/smoke-test.mjs",
    "load": "node ./tests/load/load-test.mjs"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "body-parser": "^2.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "thread-stream": "3.1.0",
    "typescript": "~5.9.3"
  }
}
